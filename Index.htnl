<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bài Tập 24 - Kiểm Tra Giữa Kỳ</title>
    <style>
        body { font-family: Arial, sans-serif; margin: 0; background: #1a1a2e; color: #fff; text-align: center; }
        header { background: #16213e; padding: 15px; border-bottom: 2px solid #0f3460; }
        nav { background: #0f3460; padding: 10px; display: flex; justify-content: center; gap: 8px; flex-wrap: wrap; }
        nav button { background: #e94560; color: white; border: none; padding: 8px 12px; cursor: pointer; border-radius: 5px; font-weight: bold; }
        
        /* Đèn kéo quân 3D */
        .stage { width: 180px; height: 180px; margin: 60px auto; perspective: 900px; }
        .lantern { width: 100%; height: 100%; position: relative; transform-style: preserve-3d; }
        .face { position: absolute; width: 160px; height: 160px; left: 10px; top: 10px; border: 3px solid #e94560; border-radius: 8px; overflow: hidden; }
        .face img { width: 100%; height: 100%; object-fit: cover; }
        
        .face:nth-child(1) { transform: rotateY(0deg) translateZ(150px); }
        .face:nth-child(2) { transform: rotateY(60deg) translateZ(150px); }
        .face:nth-child(3) { transform: rotateY(120deg) translateZ(150px); }
        .face:nth-child(4) { transform: rotateY(180deg) translateZ(150px); }
        .face:nth-child(5) { transform: rotateY(240deg) translateZ(150px); }
        .face:nth-child(6) { transform: rotateY(300deg) translateZ(150px); }

        #result-box { margin: 20px auto; max-width: 90%; padding: 15px; background: #16213e; border-radius: 10px; display: none; }
        #result-box img { max-width: 100%; border-radius: 8px; margin-top: 10px; border: 2px solid #fff; }
    </style>
</head>
<body>

<header>
    <h3>BÀI TẬP 24 - KIỂM TRA GIỮA KỲ</h3>
    <p>SV: <strong>Cao Đăng Quốc Thịnh</strong> | MSSV: <strong>[241A010780]</strong></p>
</header>

<nav>
    <button onclick="showHome()">Đèn Kéo Quân</button>
    <button onclick="showBT('Bài tập 17', 'bt17.jpg')">BT 17</button>
    <button onclick="showBT('Bài tập 18', 'bt18.jpg')">BT 18</button>
    <button onclick="showBT('Bài tập 19', 'bt19.jpg')">BT 19</button>
    <button onclick="showBT('Bài tập 20', 'bt20.jpg')">BT 20</button>
    <button onclick="showBT('Bài tập 21', 'bt21.jpg')">BT 21</button>
    <button onclick="showBT('Bài tập 22', 'bt22.jpg')">BT 22</button>
</nav>

<div id="lantern-section">
    <p style="font-size: 13px; color: #a2a8d3;">(Chạm/đưa chuột vào ảnh để dừng, chạm ra ngoài để quay tiếp)</p>
    <div class="stage">
        <div class="lantern" id="lantern">
            <div class="face"><img src="anh1.jpg"></div>
            <div class="face"><img src="anh2.jpg"></div>
            <div class="face"><img src="anh3.jpg"></div>
            <div class="face"><img src="anh4.jpg"></div>
            <div class="face"><img src="anh5.jpg"></div>
            <div class="face"><img src="anh6.jpg"></div>
        </div>
    </div>
</div>

<div id="result-box">
    <h4 id="bt-title"></h4>
    <img id="bt-img" src="">
</div>

<script>
    const lantern = document.getElementById('lantern');
    let angle = 0;
    let isPaused = false;

    function rotateLantern() {
        if (!isPaused) {
            angle = (angle + 0.6) % 360;
            lantern.style.transform = `rotateY(${angle}deg)`;
        }
        requestAnimationFrame(rotateLantern);
    }
    rotateLantern();

    const faces = document.querySelectorAll('.face');
    faces.forEach(face => {
        face.addEventListener('mouseenter', () => isPaused = true);
        face.addEventListener('mouseleave', () => isPaused = false);
        face.addEventListener('touchstart', () => isPaused = true);
    });
    document.body.addEventListener('touchstart', (e) => {
        if (!e.target.closest('.face')) isPaused = false;
    });

    function showBT(title, imgSrc) {
        document.getElementById('lantern-section').style.display = 'none';
        const box = document.getElementById('result-box');
        box.style.display = 'block';
        document.getElementById('bt-title').innerText = 'Kết quả ' + title;
        document.getElementById('bt-img').src = imgSrc;
    }

    function showHome() {
        document.getElementById('result-box').style.display = 'none';
        document.getElementById('lantern-section').style.display = 'block';
    }
</script>
</body>
</html>
  
